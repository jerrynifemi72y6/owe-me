<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.jerrynifemi.oweme.LiquidBackgroundView
        android:id="@+id/splashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/splashBadge"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/bg_glass_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-light"
                android:text="₦"
                android:textColor="@color/text_primary"
                android:textSize="46sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/splashTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/splash_tag"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
